diff --git a/drivers/usb/gadget/f_iap2.c b/drivers/usb/gadget/f_iap2.c
new file mode 100644
index 00000000..22e8b38b
--- /dev/null
+++ b/drivers/usb/gadget/f_iap2.c
@@ -0,0 +1,635 @@
+/*
+ * f_iap2.c -- iAP2 accessory USB function with a character device
+ *
+ * Provides the USB function the iPhone expects for the CarPlay control
+ * plane:
+ *
+ *   - one vendor-specific interface  bInterfaceClass    = 0xFF
+ *                                    bInterfaceSubClass = 0xF0
+ *                                    bInterfaceProtocol = 0x00
+ *   - two bulk endpoints (IN: gadget -> iPhone, OUT: iPhone -> gadget)
+ *   - /dev/android_iap, frame oriented: one read() returns exactly one
+ *     USB transfer, one write() submits exactly one USB transfer.
+ *
+ * DiPlay only uses open/read/write on this node, so no ioctl is needed.
+ *
+ * This file is #included by android.c (single translation unit, the same
+ * trick ncm.c uses for f_ncm.c/u_ether.c on this kernel generation), so
+ * nothing here may use MODULE_* macros or module_init/module_exit.
+ *
+ * All static symbols are iap_ prefixed to avoid clashing with the other
+ * function files included by android.c (notably f_accessory.c).
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2.
+ */
+
+#include <linux/miscdevice.h>
+#include <linux/fs.h>
+#include <linux/uaccess.h>
+#include <linux/wait.h>
+#include <linux/slab.h>
+
+#define IAP_BULK_BUFFER_SIZE		16384
+
+/* number of tx and rx requests to allocate */
+#define IAP_TX_REQ_MAX			4
+#define IAP_RX_REQ_MAX			2
+
+/* String IDs */
+#define IAP_INTERFACE_STRING_INDEX	0
+
+struct iap_dev {
+	struct usb_function	function;
+	struct usb_composite_dev *cdev;
+	spinlock_t		lock;
+
+	struct usb_ep		*ep_in;		/* gadget -> iPhone */
+	struct usb_ep		*ep_out;	/* iPhone -> gadget */
+
+	/* set to 1 when both endpoints are enabled */
+	int			online;
+	/* set to 1 when the cable goes away, cleared on open() */
+	int			disconnected;
+
+	/* synchronize access to the device file */
+	atomic_t		open_excl;
+
+	struct list_head	tx_idle;
+
+	wait_queue_head_t	read_wq;
+	wait_queue_head_t	write_wq;
+	struct usb_request	*rx_req[IAP_RX_REQ_MAX];
+	int			rx_done;
+};
+
+static struct iap_dev *_iap_dev;
+
+static inline struct iap_dev *iap_func_to_dev(struct usb_function *f)
+{
+	return container_of(f, struct iap_dev, function);
+}
+
+/*-------------------------------------------------------------------------*/
+
+static struct usb_interface_descriptor iap_interface_desc = {
+	.bLength		= USB_DT_INTERFACE_SIZE,
+	.bDescriptorType	= USB_DT_INTERFACE,
+	.bInterfaceNumber	= 0,
+	.bNumEndpoints		= 2,
+	.bInterfaceClass	= USB_CLASS_VENDOR_SPEC,	/* 0xFF */
+	.bInterfaceSubClass	= 0xF0,
+	.bInterfaceProtocol	= 0x00,
+};
+
+static struct usb_endpoint_descriptor iap_highspeed_in_desc = {
+	.bLength		= USB_DT_ENDPOINT_SIZE,
+	.bDescriptorType	= USB_DT_ENDPOINT,
+	.bEndpointAddress	= USB_DIR_IN,
+	.bmAttributes		= USB_ENDPOINT_XFER_BULK,
+	.wMaxPacketSize		= __constant_cpu_to_le16(512),
+};
+
+static struct usb_endpoint_descriptor iap_highspeed_out_desc = {
+	.bLength		= USB_DT_ENDPOINT_SIZE,
+	.bDescriptorType	= USB_DT_ENDPOINT,
+	.bEndpointAddress	= USB_DIR_OUT,
+	.bmAttributes		= USB_ENDPOINT_XFER_BULK,
+	.wMaxPacketSize		= __constant_cpu_to_le16(512),
+};
+
+static struct usb_endpoint_descriptor iap_fullspeed_in_desc = {
+	.bLength		= USB_DT_ENDPOINT_SIZE,
+	.bDescriptorType	= USB_DT_ENDPOINT,
+	.bEndpointAddress	= USB_DIR_IN,
+	.bmAttributes		= USB_ENDPOINT_XFER_BULK,
+};
+
+static struct usb_endpoint_descriptor iap_fullspeed_out_desc = {
+	.bLength		= USB_DT_ENDPOINT_SIZE,
+	.bDescriptorType	= USB_DT_ENDPOINT,
+	.bEndpointAddress	= USB_DIR_OUT,
+	.bmAttributes		= USB_ENDPOINT_XFER_BULK,
+};
+
+static struct usb_descriptor_header *fs_iap_descs[] = {
+	(struct usb_descriptor_header *) &iap_interface_desc,
+	(struct usb_descriptor_header *) &iap_fullspeed_in_desc,
+	(struct usb_descriptor_header *) &iap_fullspeed_out_desc,
+	NULL,
+};
+
+static struct usb_descriptor_header *hs_iap_descs[] = {
+	(struct usb_descriptor_header *) &iap_interface_desc,
+	(struct usb_descriptor_header *) &iap_highspeed_in_desc,
+	(struct usb_descriptor_header *) &iap_highspeed_out_desc,
+	NULL,
+};
+
+static struct usb_string iap_string_defs[] = {
+	[IAP_INTERFACE_STRING_INDEX].s	= "iAP Interface",
+	{  },	/* end of list */
+};
+
+static struct usb_gadget_strings iap_string_table = {
+	.language		= 0x0409,	/* en-US */
+	.strings		= iap_string_defs,
+};
+
+static struct usb_gadget_strings *iap_strings[] = {
+	&iap_string_table,
+	NULL,
+};
+
+/*-------------------------------------------------------------------------*/
+
+static struct usb_request *iap_request_new(struct usb_ep *ep, int buffer_size)
+{
+	struct usb_request *req = usb_ep_alloc_request(ep, GFP_KERNEL);
+
+	if (!req)
+		return NULL;
+
+	req->buf = kmalloc(buffer_size, GFP_KERNEL);
+	if (!req->buf) {
+		usb_ep_free_request(ep, req);
+		return NULL;
+	}
+
+	return req;
+}
+
+static void iap_request_free(struct usb_request *req, struct usb_ep *ep)
+{
+	if (req) {
+		kfree(req->buf);
+		usb_ep_free_request(ep, req);
+	}
+}
+
+/* add a request to the tail of a list */
+static void iap_req_put(struct iap_dev *dev, struct list_head *head,
+		struct usb_request *req)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dev->lock, flags);
+	list_add_tail(&req->list, head);
+	spin_unlock_irqrestore(&dev->lock, flags);
+}
+
+/* remove a request from the head of a list */
+static struct usb_request *iap_req_get(struct iap_dev *dev,
+		struct list_head *head)
+{
+	unsigned long flags;
+	struct usb_request *req;
+
+	spin_lock_irqsave(&dev->lock, flags);
+	if (list_empty(head)) {
+		req = NULL;
+	} else {
+		req = list_first_entry(head, struct usb_request, list);
+		list_del(&req->list);
+	}
+	spin_unlock_irqrestore(&dev->lock, flags);
+	return req;
+}
+
+static void iap_set_disconnected(struct iap_dev *dev)
+{
+	dev->online = 0;
+	dev->disconnected = 1;
+}
+
+static void iap_complete_in(struct usb_ep *ep, struct usb_request *req)
+{
+	struct iap_dev *dev = _iap_dev;
+
+	if (req->status != 0)
+		iap_set_disconnected(dev);
+
+	iap_req_put(dev, &dev->tx_idle, req);
+	wake_up(&dev->write_wq);
+}
+
+static void iap_complete_out(struct usb_ep *ep, struct usb_request *req)
+{
+	struct iap_dev *dev = _iap_dev;
+
+	dev->rx_done = 1;
+	if (req->status != 0)
+		iap_set_disconnected(dev);
+
+	wake_up(&dev->read_wq);
+}
+
+/*-------------------------------------------------------------------------*/
+
+static ssize_t iap_read(struct file *fp, char __user *buf,
+	size_t count, loff_t *pos)
+{
+	struct iap_dev *dev = fp->private_data;
+	struct usb_request *req;
+	int r = count;
+	int xfer;
+	int ret;
+
+	if (dev->disconnected)
+		return -ENODEV;
+
+	if (count > IAP_BULK_BUFFER_SIZE)
+		count = IAP_BULK_BUFFER_SIZE;
+
+	/* block until the cable is in and the host selected our alt setting */
+	ret = wait_event_interruptible(dev->read_wq,
+			dev->online || dev->disconnected);
+	if (ret < 0)
+		return ret;
+
+requeue_req:
+	req = dev->rx_req[0];
+	req->length = count;
+	dev->rx_done = 0;
+	ret = usb_ep_queue(dev->ep_out, req, GFP_KERNEL);
+	if (ret < 0)
+		return -EIO;
+
+	ret = wait_event_interruptible(dev->read_wq, dev->rx_done);
+	if (ret < 0) {
+		usb_ep_dequeue(dev->ep_out, req);
+		return ret;
+	}
+	if (!dev->online) {
+		usb_ep_dequeue(dev->ep_out, req);
+		return -EIO;
+	}
+
+	/* a zero length packet carries no frame, keep waiting */
+	if (req->actual == 0)
+		goto requeue_req;
+
+	xfer = (req->actual < count) ? req->actual : count;
+	r = xfer;
+	if (copy_to_user(buf, req->buf, xfer))
+		r = -EFAULT;
+
+	return r;
+}
+
+static ssize_t iap_write(struct file *fp, const char __user *buf,
+	size_t count, loff_t *pos)
+{
+	struct iap_dev *dev = fp->private_data;
+	struct usb_request *req = NULL;
+	int r = count;
+	int xfer;
+	int ret;
+
+	if (!dev->online || dev->disconnected)
+		return -ENODEV;
+
+	while (count > 0) {
+		if (!dev->online) {
+			r = -EIO;
+			break;
+		}
+
+		/* get an idle tx request to use */
+		req = NULL;
+		ret = wait_event_interruptible(dev->write_wq,
+			((req = iap_req_get(dev, &dev->tx_idle)) || !dev->online));
+		if (!req) {
+			r = ret;
+			break;
+		}
+
+		if (count > IAP_BULK_BUFFER_SIZE)
+			xfer = IAP_BULK_BUFFER_SIZE;
+		else
+			xfer = count;
+
+		if (copy_from_user(req->buf, buf, xfer)) {
+			r = -EFAULT;
+			break;
+		}
+
+		req->length = xfer;
+		ret = usb_ep_queue(dev->ep_in, req, GFP_KERNEL);
+		if (ret < 0) {
+			pr_err("iap_write: xfer error %d\n", ret);
+			r = -EIO;
+			break;
+		}
+
+		buf += xfer;
+		count -= xfer;
+
+		/* zero this so we don't try to free it on error exit */
+		req = NULL;
+	}
+
+	if (req)
+		iap_req_put(dev, &dev->tx_idle, req);
+
+	return r;
+}
+
+static int iap_open(struct inode *ip, struct file *fp)
+{
+	struct iap_dev *dev = _iap_dev;
+
+	if (!dev)
+		return -ENODEV;
+
+	if (atomic_xchg(&dev->open_excl, 1))
+		return -EBUSY;
+
+	dev->disconnected = 0;
+	fp->private_data = dev;
+
+	pr_info("iap_open\n");
+	return 0;
+}
+
+static int iap_release(struct inode *ip, struct file *fp)
+{
+	struct iap_dev *dev = _iap_dev;
+
+	if (!dev)
+		return 0;
+
+	atomic_set(&dev->open_excl, 0);
+	dev->disconnected = 0;
+
+	pr_info("iap_release\n");
+	return 0;
+}
+
+static const struct file_operations iap_fops = {
+	.owner		= THIS_MODULE,
+	.read		= iap_read,
+	.write		= iap_write,
+	.open		= iap_open,
+	.release	= iap_release,
+};
+
+static struct miscdevice iap_device = {
+	.minor	= MISC_DYNAMIC_MINOR,
+	.name	= "android_iap",
+	.fops	= &iap_fops,
+};
+
+/*-------------------------------------------------------------------------*/
+
+static int iap_create_bulk_endpoints(struct iap_dev *dev,
+		struct usb_endpoint_descriptor *in_desc,
+		struct usb_endpoint_descriptor *out_desc)
+{
+	struct usb_composite_dev *cdev = dev->cdev;
+	struct usb_request *req;
+	struct usb_ep *ep;
+	int i;
+
+	ep = usb_ep_autoconfig(cdev->gadget, in_desc);
+	if (!ep) {
+		pr_err("iap: usb_ep_autoconfig for ep_in failed\n");
+		return -ENODEV;
+	}
+	ep->driver_data = dev;
+	dev->ep_in = ep;
+	pr_info("iap: usb_ep_autoconfig for ep_in got %s\n", ep->name);
+
+	ep = usb_ep_autoconfig(cdev->gadget, out_desc);
+	if (!ep) {
+		pr_err("iap: usb_ep_autoconfig for ep_out failed\n");
+		return -ENODEV;
+	}
+	ep->driver_data = dev;
+	dev->ep_out = ep;
+	pr_info("iap: usb_ep_autoconfig for ep_out got %s\n", ep->name);
+
+	/* now allocate requests for our endpoints */
+	for (i = 0; i < IAP_TX_REQ_MAX; i++) {
+		req = iap_request_new(dev->ep_in, IAP_BULK_BUFFER_SIZE);
+		if (!req)
+			goto fail;
+		req->complete = iap_complete_in;
+		iap_req_put(dev, &dev->tx_idle, req);
+	}
+
+	for (i = 0; i < IAP_RX_REQ_MAX; i++) {
+		req = iap_request_new(dev->ep_out, IAP_BULK_BUFFER_SIZE);
+		if (!req)
+			goto fail;
+		req->complete = iap_complete_out;
+		dev->rx_req[i] = req;
+	}
+
+	return 0;
+
+fail:
+	pr_err("iap: could not allocate requests\n");
+	while ((req = iap_req_get(dev, &dev->tx_idle)))
+		iap_request_free(req, dev->ep_in);
+	for (i = 0; i < IAP_RX_REQ_MAX; i++)
+		iap_request_free(dev->rx_req[i], dev->ep_out);
+	return -ENOMEM;
+}
+
+static int iap_function_bind(struct usb_configuration *c,
+		struct usb_function *f)
+{
+	struct usb_composite_dev *cdev = c->cdev;
+	struct iap_dev *dev = iap_func_to_dev(f);
+	int id;
+	int ret;
+
+	pr_info("iap_function_bind dev: %p\n", dev);
+
+	/* allocate interface ID(s) */
+	id = usb_interface_id(c, f);
+	if (id < 0)
+		return id;
+	iap_interface_desc.bInterfaceNumber = id;
+
+	/* allocate endpoints */
+	ret = iap_create_bulk_endpoints(dev, &iap_fullspeed_in_desc,
+			&iap_fullspeed_out_desc);
+	if (ret)
+		return ret;
+
+	/* support high speed hardware */
+	if (gadget_is_dualspeed(cdev->gadget)) {
+		iap_highspeed_in_desc.bEndpointAddress =
+			iap_fullspeed_in_desc.bEndpointAddress;
+		iap_highspeed_out_desc.bEndpointAddress =
+			iap_fullspeed_out_desc.bEndpointAddress;
+	}
+
+	pr_info("iap: %s speed IN/%s OUT/%s\n",
+		gadget_is_dualspeed(cdev->gadget) ? "dual" : "full",
+		dev->ep_in->name, dev->ep_out->name);
+	return 0;
+}
+
+static void iap_function_unbind(struct usb_configuration *c,
+		struct usb_function *f)
+{
+	struct iap_dev *dev = iap_func_to_dev(f);
+	struct usb_request *req;
+	int i;
+
+	while ((req = iap_req_get(dev, &dev->tx_idle)))
+		iap_request_free(req, dev->ep_in);
+	for (i = 0; i < IAP_RX_REQ_MAX; i++)
+		iap_request_free(dev->rx_req[i], dev->ep_out);
+}
+
+static int iap_function_set_alt(struct usb_function *f,
+		unsigned intf, unsigned alt)
+{
+	struct iap_dev *dev = iap_func_to_dev(f);
+	struct usb_composite_dev *cdev = f->config->cdev;
+	int ret;
+
+	pr_info("iap_function_set_alt intf: %d alt: %d\n", intf, alt);
+
+	ret = usb_ep_enable(dev->ep_in,
+			ep_choose(cdev->gadget,
+				&iap_highspeed_in_desc,
+				&iap_fullspeed_in_desc));
+	if (ret)
+		return ret;
+
+	ret = usb_ep_enable(dev->ep_out,
+			ep_choose(cdev->gadget,
+				&iap_highspeed_out_desc,
+				&iap_fullspeed_out_desc));
+	if (ret) {
+		usb_ep_disable(dev->ep_in);
+		return ret;
+	}
+
+	dev->online = 1;
+	dev->disconnected = 0;
+
+	/* readers may be blocked waiting for us to go online */
+	wake_up(&dev->read_wq);
+	wake_up(&dev->write_wq);
+	return 0;
+}
+
+static void iap_function_disable(struct usb_function *f)
+{
+	struct iap_dev *dev = iap_func_to_dev(f);
+
+	pr_info("iap_function_disable\n");
+
+	iap_set_disconnected(dev);
+	usb_ep_disable(dev->ep_in);
+	usb_ep_disable(dev->ep_out);
+
+	/* readers may be blocked waiting for us to go online */
+	wake_up(&dev->read_wq);
+	wake_up(&dev->write_wq);
+}
+
+/*
+ * Apple's vendor request 0x51 asks the accessory to flip USB roles.
+ *
+ * We deliberately stay a USB device: in this topology the iPhone is the
+ * host and drives the CarPlay data plane over our CDC-NCM interface
+ * (usb0). Accept the request and do nothing, so the control pipe stays
+ * healthy instead of being STALLed.
+ */
+static int iap_function_setup(struct usb_function *f,
+		const struct usb_ctrlrequest *ctrl)
+{
+	u8 type = ctrl->bRequestType;
+	u8 req = ctrl->bRequest;
+	u16 w_value = le16_to_cpu(ctrl->wValue);
+	u16 w_index = le16_to_cpu(ctrl->wIndex);
+	u16 w_length = le16_to_cpu(ctrl->wLength);
+
+	if ((type & USB_TYPE_MASK) != USB_TYPE_VENDOR)
+		return -EOPNOTSUPP;
+
+	pr_info("iap2 vendor request bRequest=%02x wValue=%04x wIndex=%04x wLength=%d\n",
+		req, w_value, w_index, w_length);
+
+	if (req == 0x51)
+		return 0;
+
+	return -EOPNOTSUPP;
+}
+
+/*-------------------------------------------------------------------------*/
+
+static int iap_setup(void)
+{
+	struct iap_dev *dev;
+	int ret;
+
+	if (_iap_dev)
+		return 0;
+
+	dev = kzalloc(sizeof(*dev), GFP_KERNEL);
+	if (!dev)
+		return -ENOMEM;
+
+	spin_lock_init(&dev->lock);
+	init_waitqueue_head(&dev->read_wq);
+	init_waitqueue_head(&dev->write_wq);
+	atomic_set(&dev->open_excl, 0);
+	INIT_LIST_HEAD(&dev->tx_idle);
+
+	/* _iap_dev must be set before registering the chardev, because
+	 * read()/write() dereference it as soon as a file is opened.
+	 */
+	_iap_dev = dev;
+
+	ret = misc_register(&iap_device);
+	if (ret) {
+		pr_err("iap: misc_register failed %d\n", ret);
+		_iap_dev = NULL;
+		kfree(dev);
+		return ret;
+	}
+
+	pr_info("iap: /dev/android_iap registered\n");
+	return 0;
+}
+
+static void iap_cleanup(void)
+{
+	if (!_iap_dev)
+		return;
+
+	misc_deregister(&iap_device);
+	kfree(_iap_dev);
+	_iap_dev = NULL;
+}
+
+static int iap_bind_config(struct usb_configuration *c)
+{
+	struct iap_dev *dev = _iap_dev;
+
+	if (!dev) {
+		pr_err("iap_bind_config: device not set up\n");
+		return -ENODEV;
+	}
+
+	dev->cdev = c->cdev;
+	dev->function.name = "iap";
+	dev->function.strings = iap_strings;
+	dev->function.descriptors = fs_iap_descs;
+	dev->function.hs_descriptors = hs_iap_descs;
+	dev->function.bind = iap_function_bind;
+	dev->function.unbind = iap_function_unbind;
+	dev->function.set_alt = iap_function_set_alt;
+	dev->function.disable = iap_function_disable;
+	dev->function.setup = iap_function_setup;
+
+	return usb_add_function(c, &dev->function);
+}
