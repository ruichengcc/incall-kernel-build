 #include "rndis.c"
 #include "u_ether.c"
 
+/* CDC-NCM function. Paired with f_iap this gives the iPhone a real
+ * IP-capable interface, which is what Wired CarPlay's data plane needs.
+ * Same model as f_rndis above: single translation unit, no export needed.
+ */
+#include "f_ncm.c"
+
+/* iAP2 accessory function, exposing /dev/android_iap. The control plane
+ * DiPlay speaks to the iPhone goes through this chardev.
+ */
+#include "f_iap2.c"
+
 MODULE_AUTHOR("Mike Lockwood");
 MODULE_DESCRIPTION("Android Composite USB Driver");
 MODULE_LICENSE("GPL");
@@ -523,6 +534,133 @@ static struct android_usb_function rndis_function = {
 };
 
 
+/* CDC-NCM: the interface the iPhone expects for CarPlay's IP data plane.
+ * Netdev is named usb0 (netname "usb"), which is the standard CarPlay layout.
+ * Note: gether_setup_name() is single-instance, so ncm and rndis must not be
+ * enabled at the same time (only one netdev can exist).
+ */
+struct ncm_function_config {
+	u8	ethaddr[ETH_ALEN];
+};
+
+static int ncm_function_init(struct android_usb_function *f,
+		struct usb_composite_dev *cdev)
+{
+	f->config = kzalloc(sizeof(struct ncm_function_config), GFP_KERNEL);
+	if (!f->config)
+		return -ENOMEM;
+	return 0;
+}
+
+static void ncm_function_cleanup(struct android_usb_function *f)
+{
+	kfree(f->config);
+	f->config = NULL;
+}
+
+static int ncm_function_bind_config(struct android_usb_function *f,
+		struct usb_configuration *c)
+{
+	int ret;
+	struct ncm_function_config *ncm = f->config;
+
+	if (!ncm) {
+		pr_err("%s: ncm_pdata\n", __func__);
+		return -1;
+	}
+
+	ret = gether_setup_name(c->cdev->gadget, ncm->ethaddr, "usb");
+	if (ret) {
+		pr_err("%s: gether_setup_name failed\n", __func__);
+		return ret;
+	}
+
+	pr_info("%s netdev usb0 MAC %02X:%02X:%02X:%02X:%02X:%02X\n", __func__,
+		ncm->ethaddr[0], ncm->ethaddr[1], ncm->ethaddr[2],
+		ncm->ethaddr[3], ncm->ethaddr[4], ncm->ethaddr[5]);
+
+	ret = ncm_bind_config(c, ncm->ethaddr);
+	if (ret) {
+		pr_err("%s: ncm_bind_config failed %d\n", __func__, ret);
+		gether_cleanup();
+	}
+	return ret;
+}
+
+static void ncm_function_unbind_config(struct android_usb_function *f,
+		struct usb_configuration *c)
+{
+	gether_cleanup();
+}
+
+static ssize_t ncm_ethaddr_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct android_usb_function *f = dev_get_drvdata(dev);
+	struct ncm_function_config *ncm = f->config;
+	return sprintf(buf, "%02x:%02x:%02x:%02x:%02x:%02x\n",
+		ncm->ethaddr[0], ncm->ethaddr[1], ncm->ethaddr[2],
+		ncm->ethaddr[3], ncm->ethaddr[4], ncm->ethaddr[5]);
+}
+
+static ssize_t ncm_ethaddr_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t size)
+{
+	struct android_usb_function *f = dev_get_drvdata(dev);
+	struct ncm_function_config *ncm = f->config;
+
+	if (sscanf(buf, "%02x:%02x:%02x:%02x:%02x:%02x\n",
+		    (int *)&ncm->ethaddr[0], (int *)&ncm->ethaddr[1],
+		    (int *)&ncm->ethaddr[2], (int *)&ncm->ethaddr[3],
+		    (int *)&ncm->ethaddr[4], (int *)&ncm->ethaddr[5]) == 6)
+		return size;
+	return -EINVAL;
+}
+
+static DEVICE_ATTR(ncm_ethaddr, S_IRUGO | S_IWUSR, ncm_ethaddr_show,
+					       ncm_ethaddr_store);
+
+static struct device_attribute *ncm_function_attributes[] = {
+	&dev_attr_ncm_ethaddr,
+	NULL
+};
+
+static struct android_usb_function ncm_function = {
+	.name		= "ncm",
+	.init		= ncm_function_init,
+	.cleanup	= ncm_function_cleanup,
+	.bind_config	= ncm_function_bind_config,
+	.unbind_config	= ncm_function_unbind_config,
+	.attributes	= ncm_function_attributes,
+};
+
+
+/* iAP2 accessory: the chardev face of f_iap2.c, same wiring as accessory */
+static int iap_android_function_init(struct android_usb_function *f,
+					struct usb_composite_dev *cdev)
+{
+	return iap_setup();
+}
+
+static void iap_android_function_cleanup(struct android_usb_function *f)
+{
+	iap_cleanup();
+}
+
+static int iap_android_function_bind_config(struct android_usb_function *f,
+						struct usb_configuration *c)
+{
+	return iap_bind_config(c);
+}
+
+static struct android_usb_function iap_android_function = {
+	.name		= "iap",
+	.init		= iap_android_function_init,
+	.cleanup	= iap_android_function_cleanup,
+	.bind_config	= iap_android_function_bind_config,
+};
+
+
